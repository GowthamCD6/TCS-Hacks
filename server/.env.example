# RecoverIQ Node backend. Copy to server/.env. Placeholders only.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-same-value-as-ai-service
LOG_LEVEL=info
# Serves recorded responses with no database or AI service
MOCK_MODE=false

JWT_SECRET=change-me
OWNER_API_TOKEN=change-me
WEBHOOK_TOKEN=change-me
DEMO_APPROVER_EMAIL=approver@recoveriq.demo
DEMO_APPROVER_PASSWORD=change-me
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
STUDENT_RATE_LIMIT_MAX=60

DB_HOST=your-host
DB_PORT=4000
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=tcsmainday
DB_SSL=true
DB_SSL_CA=isrgrootx1.pem

# Python used for the evaluation script
PYTHON_BIN=python
WORKER_ENABLED=true
