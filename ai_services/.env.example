# RecoverIQ AI service. Copy to ai_services/.env. Placeholders only.
AI_SERVICE_TOKEN=change-me-same-value-as-server
# Read-only database user. Python never writes.
AI_DB_URL=mysql://readonly_user:password@host:4000/database_name
# Path to the TLS CA bundle, needed for TiDB Cloud
AI_DB_SSL_CA=../server/isrgrootx1.pem

# LLM: "none" runs the full golden path with rules and templates
LLM_PROVIDER=none
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Check the model ID against the current Groq model catalogue
GROQ_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REFUND_GRACE_MINUTES=1440
